# 悦读小将 - 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ==================== 端口配置 ====================
FLASK_PORT=5000
FLASK_ENV=production

# ==================== 挂载路径配置（Docker部署专用）====================
# 宿主机路径（服务器上的实际目录）
HOST_AUDIO_PATH=/www/dk_project/wwwroot/lit.handy.xin/audio_files
HOST_ICONS_PATH=/www/dk_project/wwwroot/lit.handy.xin/book_icons
HOST_ENV_PATH=/www/dk_project/wwwroot/lit.handy.xin/.env

# 容器内路径（与代码中的配置一致）
CONTAINER_AUDIO_PATH=/app/audio_files
CONTAINER_ICONS_PATH=/app/frontend/book_icons
CONTAINER_ENV_PATH=/app/.env

# ==================== MySQL 数据库配置 ====================
DB_HOST=172.17.0.1
DB_PORT=3306
DB_USER=reader
DB_PASSWORD=your_password
DB_NAME=reading_companion

# ==================== AI 服务配置 ====================
# GLM API（优先使用）
GLM_API_KEY=your_key

# 豆包API（GLM失败时备用）
ARK_API_KEY=your_key

# ==================== 百度TTS配置 ====================
BAIDU_TTS_API_KEY=your_key
BAIDU_TTS_APP_ID=your_app_id
BAIDU_TTS_SECRET_KEY=your_secret

# ==================== 微信公众号配置（可选）====================
WECHAT_TOKEN=your_token
WECHAT_APPID=your_appid
WECHAT_APPSECRET=your_appsecret

# ==================== 应用程序内部路径配置（需与容器内路径一致）====================
BOOK_ICONS_PATH=/app/frontend/book_icons
AUDIO_FILES_PATH=/app/audio_files
